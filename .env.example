# Copy this file to .env and fill in real values.
# Empty values fall back to the defaults baked into translator.config.

# ---------------------------------------------------------------------------
# API keys
# ---------------------------------------------------------------------------

# OpenAI: used by default for the comparison, clustering, and judge models.
# Requests go through the Responses API; reasoning.effort is set per role
# (see REASONING_EFFORT_* below).
OPENAI_API_KEY=sk-...

# Anthropic: used by default for the translation model (claude-opus-4-7).
# Required to run `translator translate` unless you override MODEL_TRANSLATION.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Model overrides (optional)
# v3 deliberately splits work across providers so the translator and the
# deviation-extractor don't share a blind spot. Keep MODEL_COMPARISON in a
# different family than MODEL_TRANSLATION.
#
# Defaults below match translator.config.Models.
# ---------------------------------------------------------------------------

# MODEL_TRANSLATION=claude-opus-4-7
# MODEL_COMPARISON=gpt-5.5
# MODEL_CLUSTERING=gpt-5.5
# MODEL_JUDGE=gpt-5.5

# ---------------------------------------------------------------------------
# OpenAI reasoning.effort per role (Responses API only).
# Allowed values: none / low / medium / high / xhigh.
# ---------------------------------------------------------------------------

# REASONING_EFFORT_COMPARISON=high
# REASONING_EFFORT_CLUSTERING=medium
# REASONING_EFFORT_JUDGE=high

# ---------------------------------------------------------------------------
# Scraper config
# ---------------------------------------------------------------------------

SCRAPER_USER_AGENT=ln-translator/0.2 (research; contact: you@example.com)

# Optional rate-limit overrides (seconds between requests).
SCRAPER_DELAY_KAKUYOMU=1.5
SCRAPER_DELAY_AVELILIUM=1.0
